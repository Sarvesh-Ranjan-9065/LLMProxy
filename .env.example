# Example environment file for local development
# Copy this file to `.env` and fill values as needed. DO NOT commit `.env` with secrets.

# Proxy / server
PROXY_PORT=8080

# Redis (use a local Redis during development or point to your cluster)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker backend URLs (used when not providing CONFIG_FILE)
WORKER_1_URL=http://localhost:9001
WORKER_2_URL=http://localhost:9002
WORKER_3_URL=http://localhost:9003

# Optional path to a JSON config file that can override defaults
# Example format: { "auth": { "api_keys": { "test-key": "test-user" } } }
CONFIG_FILE=

# Cache settings
CACHE_ENABLED=true
# TTL can be a duration like 5m, 300s
CACHE_TTL=5m

# Rate limit defaults (numbers)
RATE_LIMIT_DEFAULT_RATE=10
RATE_LIMIT_DEFAULT_BURST=20

# Note:
# - Do not place real API keys or secrets in version control.
# - For production, use a secrets manager or Kubernetes Secrets and avoid committing `.env`.

