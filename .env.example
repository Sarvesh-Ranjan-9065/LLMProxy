# Example environment file for local development
# Copy this file to `.env` and fill values as needed. DO NOT commit `.env` with secrets.

# Proxy
PROXY_PORT=8080

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Workers
WORKER_1_URL=http://localhost:9001
WORKER_2_URL=http://localhost:9002
WORKER_3_URL=http://localhost:9003

# Auth (JSON map of API keys)
API_KEYS_JSON={"user-key":{"owner":"alice","role":"user"},"admin-key":{"owner":"ops","role":"admin"}}

# Metrics
ENABLE_PER_KEY_METRICS=false

# Backend auth injection (optional)
PROXY_BACKEND_AUTH_HEADER=Authorization
PROXY_BACKEND_AUTH_VALUE=Bearer backend-token
PROXY_BACKEND_AUTH_PASSTHROUGH=false

# Note:
# - Do not place real API keys or secrets in version control.
# - For production, use a secrets manager or Kubernetes Secrets and avoid committing `.env`.

